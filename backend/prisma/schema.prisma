generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  apiKeys   ApiKey[]
  histories History[]
}

model ApiKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  cipher    String
  iv        String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model History {
  id         String   @id @default(cuid())
  userId     String
  title      String
  request    String
  response   String
  durationMs Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
