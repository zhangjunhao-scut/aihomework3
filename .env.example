# 后端环境变量示例（复制为 .env 后填写）
# JWT 签名密钥（随机长字符串）
JWT_SECRET=change-me-to-a-very-long-random-string
# API Key 加密密钥（32 字节 base64 或 hex；可用 `openssl rand -hex 32` 生成）
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# 前端 origin（CORS 白名单）
FRONTEND_ORIGIN=http://localhost:5173
# 是否允许自定义 BaseURL（true/false），默认 false 防 SSRF
ALLOW_CUSTOM_BASEURL=false
